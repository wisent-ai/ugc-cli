UGC_DB_PATH=.ugc/ugc.db
UGC_ASSET_DIR=.ugc/assets

# Optional central first-use journey transport; without both values it stays offline.
STADO_INTEGRATION_API_URL=
UGC_CLI_STADO_INTEGRATION_TOKEN=

# Provider connections should reference secrets by source, for example:
# file:.ugc/provider.env#UGC_HTTP_TOKEN
UGC_HTTP_BASE_URL=
UGC_HTTP_TOKEN_SOURCE=
UGC_HTTP_WEBHOOK_SECRET_SOURCE=

# Weles account_action_logs queue
WELES_SUPABASE_URL=
WELES_TOKEN_SOURCE=file:.ugc/wisent-tools.env#WELES_SERVICE_ROLE_KEY

# Brama model gateway
BRAMA_URL=
UGC_BRAMA_AGENT_ID=
UGC_BRAMA_SIGNING_SECRET_SOURCE=file:.ugc/wisent-tools.env#BRAMA_REQUEST_SIGNING_SECRET
