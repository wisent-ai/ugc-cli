{
  "schema_version": 1,
  "product": "ugc-cli",
  "releases": true,
  "version_source": {
    "kind": "regex",
    "path": "Cargo.toml",
    "pattern": "(?m)^version\\s*=\\s*\"(?P<version>[0-9A-Za-z.+-]+)\"\\s*$"
  },
  "platforms": {
    "darwin-arm64": {
      "runner_platform": "darwin-arm64",
      "quality": [
        {
          "name": "cargo-check",
          "argv": ["stado", "product", "cargo", "check"]
        }
      ],
      "build": {
        "argv": ["stado", "product", "cargo", "stage", "--bin", "ugc-cli"]
      },
      "tests": [
        {"name": "cargo-test", "argv": ["stado", "product", "cargo", "test"]}
      ],
      "stage": {
        ".wisent-output/ugc-cli": "bin/ugc-cli"
      }
    },
    "linux-amd64": {
      "runner_platform": "linux-amd64",
      "quality": [
        {
          "name": "cargo-check",
          "argv": ["stado", "product", "cargo", "check"]
        }
      ],
      "build": {
        "argv": ["stado", "product", "cargo", "stage", "--bin", "ugc-cli"]
      },
      "tests": [
        {"name": "cargo-test", "argv": ["stado", "product", "cargo", "test"]}
      ],
      "stage": {
        ".wisent-output/ugc-cli": "bin/ugc-cli"
      }
    }
  },
  "inputs": {},
  "promotion": {
    "channels": [
      "candidate",
      "stable"
    ],
    "reconcile": false
  }
}
